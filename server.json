{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.lohithry/divlens",
  "description": "Real-time system diagnostics for AI agents — CPU, RAM, disk, network, hardware health. 17 tools.",
  "repository": {
    "url": "https://github.com/Lohithry/divlens-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "github_release",
      "identifier": "Lohithry/divlens-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio",
        "command": "divlens-core",
        "arguments": ["--mcp"]
      }
    }
  ]
}