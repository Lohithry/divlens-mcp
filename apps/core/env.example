# DivLens Core — Environment Configuration
#
# Copy this file to .env and edit as needed.
# MCP mode (--mcp) works fully offline with NO environment variables required.
# All settings below are optional development overrides.

# ─── Debug ────────────────────────────────────────────────────────────────────
# Uncomment to enable verbose Rust tracing output (written to stderr).
# Equivalent to passing --debug on the command line.
# RUST_LOG=debug

# ─── Data Directory ───────────────────────────────────────────────────────────
# Override the default OS-standard data directory for the SQLite database.
# Defaults:
#   macOS:   ~/Library/Application Support/divlens/
#   Linux:   ~/.local/share/divlens/
#   Windows: %APPDATA%\divlens\
# DIVLENS_DATA_DIR=/path/to/custom/dir
